#!/bin/sh

# Pre-commit hook: Run prettier and eslint on staged files only
# Fails if formatting/linting changes any files (ensures code is pre-formatted)

echo "🔍 Checking staged files..."

# Get list of staged files (only existing files, not deleted ones)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Exclude pnpm-lock.yaml from staged files
STAGED_FILES=$(echo "$STAGED_FILES" | grep -v 'pnpm-lock.yaml')

if [ -z "$STAGED_FILES" ]; then
    echo "No staged files to check."
    exit 0
fi

echo "📝 Found staged files:"
echo "$STAGED_FILES" | sed 's/^/  - /'
echo ""

# Run prettier on staged files
echo "🎨 Running prettier on staged files..."

# Filter for files that prettier can handle
PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|json|md|yml|yaml|css|scss|html)$' || true)

if [ -n "$PRETTIER_FILES" ]; then
    echo "$PRETTIER_FILES" | xargs pnpm prettier --write --ignore-unknown
    PRETTIER_EXIT=$?

    if [ $PRETTIER_EXIT -ne 0 ]; then
        echo "❌ Prettier failed!"
        exit 1
    fi
else
    echo "ℹ️  No files to format with prettier"
fi

# Run eslint on staged files
echo ""
echo "🔧 Running eslint on staged files..."

# Filter for files that eslint can handle, only in apps/ or packages/
ESLINT_FILES=$(echo "$STAGED_FILES" | grep -E '\\.(ts|tsx|js|jsx)$' | grep -E '^(apps|packages)/' || true)

if [ -n "$ESLINT_FILES" ]; then
    echo "$ESLINT_FILES" | xargs pnpm eslint --fix
    ESLINT_EXIT=$?

    if [ $ESLINT_EXIT -ne 0 ]; then
        echo "❌ ESLint failed!"
        exit 1
    fi
else
    echo "ℹ️  No files to lint with eslint"
fi

# Check if any staged files were modified by formatting
echo ""
echo "🔎 Checking for changes after formatting..."

MODIFIED_FILES=""
for FILE in $STAGED_FILES; do
    # Check if file still exists and has changes
    if [ -f "$FILE" ]; then
        git diff --exit-code "$FILE" > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            MODIFIED_FILES="$MODIFIED_FILES\n  - $FILE"
        fi
    fi
done

if [ -n "$MODIFIED_FILES" ]; then
    echo ""
    echo "❌ ERROR: Formatting changed the following staged files:"
    echo "$MODIFIED_FILES"
    echo ""
    echo "The files were automatically formatted but not staged."
    echo "Please review and stage the changes, then commit again:"
    echo ""
    echo "  git add -u"
    echo "  git commit"
    echo ""
    exit 1
fi

echo "✅ All staged files are properly formatted!"
exit 0
