# Vite dev server port — override per workspace to avoid collisions
WEB_PORT=5173

# API Configuration
# Port must match the api's PORT / root DATABASE_PORT setup
VITE_API_URL=http://localhost:3000

# Auth Configuration
# Set to true to use fake auth provider (dev only)
VITE_FAKE_AUTH=true
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Assistant (AGO) — leave VITE_AGO_BASE_URL unset to disable the assistant
VITE_AGO_BASE_URL=https://playground.api.useago.com
VITE_AGO_AGENT=generic-guide
