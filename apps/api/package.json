{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "Template API",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "check-types": "tsc -b --noEmit",
    "command:build-and-run:example": "pnpm build && pnpm command:run:example",
    "command:run:example": "node dist/src/commands/main.js example",
    "coverage:merge": "node scripts/merge-coverage.mts",
    "coverage:report": "mkdir -p coverage/.nyc_output && cp coverage/merged/coverage-final.json coverage/.nyc_output/out.json && nyc report --temp-dir=coverage/.nyc_output --reporter=html --reporter=text-summary --reporter=json-summary --report-dir=coverage/final",
    "db:migrate:create": "mikro-orm migration:create",
    "db:migrate:down": "mikro-orm migration:down",
    "db:migrate:fresh": "mikro-orm migration:fresh",
    "db:migrate:up": "mikro-orm migration:up",
    "db:schema:update": "mikro-orm schema:update --run",
    "db:seed:local": "mikro-orm seeder:run --class=LocalDatabaseSeeder",
    "db-e2e:migrate:down": "set -a; . ./.env.e2e; [ -f .env.e2e.local ] && . ./.env.e2e.local; set +a; mikro-orm migration:down",
    "db-e2e:migrate:fresh": "set -a; . ./.env.e2e; [ -f .env.e2e.local ] && . ./.env.e2e.local; set +a; mikro-orm migration:fresh",
    "db-e2e:migrate:up": "set -a; . ./.env.e2e; [ -f .env.e2e.local ] && . ./.env.e2e.local; set +a; mikro-orm migration:up",
    "dev": "pnpm start:dev",
    "format": "pnpm run prettier:fix && pnpm run lint:fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "NODE_ENV=test vitest run",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:cov:all": "pnpm test:cov && pnpm test:cov:e2e",
    "test:cov:e2e": "NODE_ENV=test vitest run --coverage --config ./vitest.e2e.config.mts",
    "test:cov:merged": "pnpm test:cov:all && pnpm coverage:merge && pnpm coverage:report",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.e2e.config.mts",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@mikro-orm/cli": "^7.1.4",
    "@mikro-orm/core": "^7.1.4",
    "@mikro-orm/decorators": "^7.1.4",
    "@mikro-orm/migrations": "^7.1.4",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.4",
    "@mikro-orm/reflection": "^7.1.4",
    "@mikro-orm/seeder": "^7.1.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "^1.2.5",
    "@workspace/api-contracts": "workspace:*",
    "@workspace/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "^6.2.3",
    "nest-commander": "^3.20.1",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.6.1",
    "openid-client": "^6.8.4",
    "pg": "8.22.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/express": "^5.0.6",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "26.0.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "nest-commander-testing": "^3.5.1",
    "nyc": "^18.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.cli.config.ts"
    ],
    "tsConfigPath": "./tsconfig.mikro-cli.json",
    "tsLoader": "swc"
  }
}
