# Environment Configuration
# Copy this file to .env and modify as needed

# App environment
NODE_ENV=development

# App port
PORT=3000

# Database connection string
# Port must match DATABASE_PORT in the root .env (docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kosmos

# Database connection pool config
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# Authentication
# Set FAKE_AUTH=true to bypass JWT verification in development
FAKE_AUTH=true

# When FAKE_AUTH=false, configure your OIDC provider:
AUTH_CLIENT_ID=your-client-id
AUTH_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_ALLOWED_EMAILS=person@example.com,another-person@example.com

# Local seed data: which account owns the seeded fixture project
SEED_OWNER_EMAIL=mock@example.com

# Maximum projects one user may own — bounds accidents, not usage
MAX_OWNED_PROJECTS=20
