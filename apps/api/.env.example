# Environment Configuration
# Copy this file to .env and modify as needed

# App environment
NODE_ENV=development

# App port
PORT=3000

# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs

# Database connection pool config
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000

# Authentication
# Set FAKE_AUTH=true to bypass JWT verification in development
FAKE_AUTH=true

# When FAKE_AUTH=false, configure your OIDC provider:
AUTH_CLIENT_ID=your-client-id
AUTH_OIDC_DISCOVERY_URL=https://your-auth-provider.com/.well-known/openid-configuration
AUTH_ACCEPTED_SCOPES=access-as-user
