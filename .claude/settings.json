{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "bypassPermissions",
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(git push --force*)",
      "Bash(* > /dev/sda*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)"
    ]
  }
}

