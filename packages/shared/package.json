{
  "name": "@workspace/shared",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./format-date": {
      "types": "./dist/format-date.d.ts",
      "import": "./dist/format-date.js",
